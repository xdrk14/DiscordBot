# Copy this file to ".env" and fill in your own values. Never commit the real ".env" file.

DISCORD_TOKEN=your-bot-token-here

# Port for the dashboard. Pterodactyl-based hosts (e.g. WispByte) inject SERVER_PORT
# automatically - PORT is just the local-dev fallback. Default: 3000.
PORT=3000

# Password required to log into the web dashboard. REQUIRED once this runs anywhere
# other than your own PC - without it, anyone who finds the dashboard URL has full control.
# If left unset (or left as the placeholder below), a random one is generated each boot
# and printed to the console.
DASHBOARD_PASSWORD=changeme123

# Long random string used to sign login sessions. Any long random value works.
SESSION_SECRET=change-this-to-a-long-random-string

# Guild the bot mainly operates in (used by the dashboard/status page, and to register
# slash commands instantly instead of waiting up to an hour). Right-click your server icon
# in Discord with Developer Mode on -> Copy Server ID.
GUILD_ID=

# Public URL people should use to reach the dashboard once deployed (e.g. on WispByte this
# is the IP:port or domain WispByte gives your server's allocation). Used to build every
# dashboard/login link, including the /dashboard command's one-time link. Strip any
# trailing slash. If left blank, falls back to http://SERVER_IP:PORT (when the host
# provides SERVER_IP), then http://localhost:PORT.
PUBLIC_URL=
